# Local development — copy to .env
# Predict works offline if artifacts/models/*.cbm exist.
# Train/refresh-data needs DATABASE_URL (usually run on server; see README).

DATABASE_URL=postgresql://crawl_user:YOUR_PASSWORD@127.0.0.1:5432/crawl

HOST=127.0.0.1
PORT=8093
DEBUG=true

MODEL_DIR=artifacts/models
DATA_CACHE_DIR=artifacts/datasets
MIN_TRAINING_ROWS=80
TRAIN_TEST_SIZE=0.2
RANDOM_SEED=42
OUTLIER_IQR_MULTIPLIER=1.5

COMPARABLE_AREA_TOLERANCE_PCT=0.15
COMPARABLE_MIN_SAMPLE=5

RENT_RATIO_DEPOSIT_TOMAN=10000000
RENT_RATIO_MONTHLY_TOMAN=300000
RENT_MAX_DEPOSIT_TOMAN=5000000000
RENT_MAX_MONTHLY_TOMAN=200000000
RENT_MAX_EQUIVALENT_TOMAN=8000000000
RENT_MIN_EQUIVALENT_TOMAN=10000000
RENT_OUTLIER_IQR_MULTIPLIER=1.0
RENT_MISMAPPED_DEPOSIT_MAX_TOMAN=100000000
