[Unit]
Description=Nightly rebuild of the neighbourhood analytics frames

[Timer]
# 04:30 Tehran (01:00 UTC) — after the night's crawl, before the morning's readers.
OnCalendar=*-*-* 01:00:00 UTC
# A server that was off at 01:00 still gets a fresh frame when it comes back.
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
